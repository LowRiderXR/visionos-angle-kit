+// VC multiview (Stufe 4a): mirror of ContextGL's GetInstancedDrawAdjustedInstanceCount.
+// The instanced-multiview emulation runs numViews instances per source instance and
+// derives ViewID = instance % numViews in the shader, so every draw into a multiview
+// framebuffer becomes an instanced draw with the count multiplied. Zero stays the
+// "not instanced" sentinel only when multiview is off.
+static GLsizei AdjustInstancesForMultiview(const gl::State &glState, GLsizei instances)
+{
+    const gl::ProgramExecutable *executable = glState.getProgramExecutable();
+    if (!executable || !executable->usesMultiview())
+    {
+        return instances;
+    }
+    const gl::Framebuffer *drawFramebuffer = glState.getDrawFramebuffer();
+    if (!drawFramebuffer || !drawFramebuffer->getState().isMultiview())
+    {
+        return instances;
+    }
+    return (instances != 0 ? instances : 1) * executable->getNumViews();
+}
