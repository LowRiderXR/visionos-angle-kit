+// The flush + collect that the memory-based GC wants. Split out of getBuffer() so the
+// deferred path runs exactly the same code once the rate-mapped pass has closed.
+void BufferManager::runMemBasedGC(ContextMtl *contextMtl, bool lotOfMemAllocedRecently)
+{
+    if (mInUseBuffers.size() > 0 && lotOfMemAllocedRecently)
+    {
+        // A considerable amount of memory has been allocated since the last GC. Wait for all
+        // pending GPU work to finish in order to unreference in-flight buffers more quickly.
+        contextMtl->flushCommandBuffer(mtl::WaitUntilFinished);
+    }
+    else
+    {
+        // Flush the current command buffer so that the in-flight buffers are scheduled and will
+        // eventually become unreferenced. They won't be collected during this GC cycle but
+        // hopefully will in the next one.
+        contextMtl->flushCommandBuffer(mtl::NoWait);
+    }
+    freeUnusedBuffers(contextMtl);
+    collectGarbage(GCReason::TotalMem);
+}
+
+void BufferManager::runPendingGC(ContextMtl *contextMtl)
+{
+    if (!mMemGCPending || contextMtl->inRateMappedRenderPass())
+    {
+        return;
+    }
+
+    const bool churn       = mMemGCPendingWithChurn;
+    mMemGCPending          = false;
+    mMemGCPendingWithChurn = false;
+    if (mMemGCPeakMem > mMemGCPeakEver)
+    {
+        mMemGCPeakEver = mMemGCPeakMem;
+    }
+    if (RasterizationRateTraceEnabled())
+    {
+        // One line per episode. peak/peakEver are the numbers that matter: they say how
+        // much the buffer set grew while the pass held the GC off, and whether that stays
+        // bounded over a long run.
+        fprintf(stderr,
+                "[angle-vrr] bufferGC deferred->run deferrals=%zu peak=%zuMB/%zubufs "
+                "peakEver=%zuMB churn=%d\n",
+                mMemGCDeferCount, mMemGCPeakMem / (1024 * 1024), mMemGCPeakInUse,
+                mMemGCPeakEver / (1024 * 1024), churn ? 1 : 0);
+    }
+    mMemGCDeferCount = 0;
+    mMemGCPeakMem    = 0;
+    mMemGCPeakInUse  = 0;
+    runMemBasedGC(contextMtl, churn);
+}
