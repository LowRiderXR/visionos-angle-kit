+namespace rx
+{
+namespace mtl
+{
+bool FrameGpuTimeEnabled()
+{
+    static const bool enabled = [] {
+        const char *e = getenv("KL_MTL_FRAME_GPU_TIME");
+        return e && e[0] == '1';
+    }();
+    return enabled;
+}
+
+namespace
+{
+struct FrameGpuTimeRing
+{
+    std::mutex lock;
+    double ms[64];
+    unsigned head = 0, count = 0;   // ring: oldest dropped when full
+};
+FrameGpuTimeRing &GetFrameGpuTimeRing()
+{
+    // Leaked singleton on purpose: no exit-time destructor (-Werror in this tree).
+    static FrameGpuTimeRing *ring = new FrameGpuTimeRing();
+    return *ring;
+}
+}  // namespace
+
+void PushFrameGpuTimeMs(double ms)
+{
+    FrameGpuTimeRing &r = GetFrameGpuTimeRing();
+    std::lock_guard<std::mutex> guard(r.lock);
+    r.ms[(r.head + r.count) % 64] = ms;
+    if (r.count < 64)
+        ++r.count;
+    else
+        r.head = (r.head + 1) % 64;
+}
+}  // namespace mtl
+}  // namespace rx
+
+// Host-side reader (dlsym, plain C): pops the oldest completed frame's GPU time in
+// milliseconds. Returns 1 if one was available, 0 otherwise.
+extern "C" __attribute__((visibility("default"))) int ANGLEMetalPopFrameGpuTimeMs(double *outMs)
+{
+    rx::mtl::FrameGpuTimeRing &r = rx::mtl::GetFrameGpuTimeRing();
+    std::lock_guard<std::mutex> guard(r.lock);
+    if (r.count == 0)
+        return 0;
+    if (outMs)
+        *outMs = r.ms[r.head];
+    r.head = (r.head + 1) % 64;
+    --r.count;
+    return 1;
+}
