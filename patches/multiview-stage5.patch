+++ b/src/libANGLE/renderer/metal/ContextMtl.mm
@@ -265,6 +265,35 @@ GLint GetOwnershipIdentity(const egl::AttributeMap &attribs)
     // deferral to one frame; relying on "the next allocation outside a pass" was
     // measured to be far weaker (episodes of ~500 deferrals, peak creeping to 177 MB).
     mBufferManager.runPendingGC(this);
+    if (mtl::RasterizationRateTraceEnabled() && mFoveatedPassBreaks > 0)
+    {
+        fprintf(stderr, "[angle-vrr] passBreaks=%u rate-mapped/layered passes ended with store "
+                        "this frame (each resumes with Load)\n",
+                mFoveatedPassBreaks);
+    }
+    mFoveatedPassBreaks = 0;
+
+    // Frame GPU time (KL_MTL_FRAME_GPU_TIME): this flush is the frame boundary.
+    // Close the entry of the frame just committed, harvest completed ones, open
+    // the next. An entry with no command buffers completes instantly with 0 ms.
+    if (mtl::FrameGpuTimeEnabled())
+    {
+        mtl::CommandQueue &q = mCmdBuffer.cmdQueue();
+        if (mFrameGpuEntry != 0)
+        {
+            mFrameGpuPending.push_back(mFrameGpuEntry);
+        }
+        while (!mFrameGpuPending.empty() && q.isTimeElapsedEntryComplete(mFrameGpuPending.front()))
+        {
+            const uint64_t id = mFrameGpuPending.front();
+            mFrameGpuPending.pop_front();
+            const double seconds = q.getTimeElapsedEntryInSeconds(id);
+            q.deleteTimeElapsedEntry(id);
+            mtl::PushFrameGpuTimeMs(seconds * 1000.0);
+        }
+        mFrameGpuEntry = q.allocateTimeElapsedEntry();
+        q.setActiveTimeElapsedEntry(mFrameGpuEntry);
+    }
     return checkCommandBufferError();
 }
