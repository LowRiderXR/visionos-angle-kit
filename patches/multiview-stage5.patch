@@ -176,7 +183,18 @@
 
 gl::Extents TextureImageSiblingMtl::getSize() const
 {
-    return mNativeTexture ? mNativeTexture->sizeAt0() : gl::Extents(0, 0, 0);
+    if (!mNativeTexture)
+    {
+        return gl::Extents(0, 0, 0);
+    }
+    gl::Extents size = mNativeTexture->sizeAt0();
+    // Metal's `depth` is 1 for 2D arrays; the GL image chain of a
+    // GL_TEXTURE_2D_ARRAY needs the layer count as depth.
+    if (mNativeTexture->textureType() == MTLTextureType2DArray)
+    {
+        size.depth = static_cast<int>(mNativeTexture->arrayLength());
+    }
+    return size;
 }
 
