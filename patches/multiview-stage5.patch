+// Klepton/multiview probe (KL_ANGLE_VRR_TRACE=1): load actions of every render
+// pass that carries a rasterization rate map or renders layered. Anything but
+// Clear on a memoryless attachment means either a planned Load (which on a
+// rate-mapped memoryless target re-warps the unresolve, see angle-metal-fixes)
+// or a skipped clear (write masks / scissor at glClear time). Tallied here per
+// pass, printed once per second next to encode/s. Index [attachment][action]:
+// attachment 0 color0, 1 depth, 2 stencil; action 0 Clear, 1 Load, 2 DontCare.
+static size_t klPassLoads[3][3]  = {};
+static size_t klPassLoadsPasses  = 0;
+static inline int klLoadActionIndex(MTLLoadAction a)
+{
+    return a == MTLLoadActionClear ? 0 : (a == MTLLoadActionLoad ? 1 : 2);
+}
